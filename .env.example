# Vint Exchange configuration. Defaults run fully offline with no secrets.

# offline | connected. The app never silently switches profiles.
PROFILE=offline

# Offline profile: SQLite file (must live under data/).
DATABASE_URL=sqlite+aiosqlite:///data/vintexchange.db

# fake | replay | grok
LLM_MODE=fake
# fake | tavily
MARKET_MODE=fake

MERCHANT_TIMEOUT_SECONDS=8
NEGOTIATION_TIMEOUT_SECONDS=30
MARKET_TIMEOUT_SECONDS=3
MAX_ROUNDS=3
NEGOTIATION_ENABLED=true

# Replay cache (LLM_MODE=replay, or LLM_MODE=grok with REPLAY_RECORD=true)
REPLAY_CACHE_PATH=data/replay_cache.json
REPLAY_RECORD=false
# Set to "fake" to fall back to the deterministic client on a replay miss.
REPLAY_FALLBACK=

# --- Connected profile (required when PROFILE=connected) ---
SUPABASE_URL=
# Server-only. Never put this in a NEXT_PUBLIC_* variable.
SUPABASE_SECRET_KEY=
# Browser-safe publishable key (select-only RLS).
SUPABASE_PUBLISHABLE_KEY=

GROK_BASE_URL=https://api.x.ai/v1
GROK_API_KEY=
GROK_MODEL=grok-4

TAVILY_API_KEY=

# Comma-separated origins allowed to call the API (e.g. the Vercel dashboard).
CORS_ORIGINS=

# --- Commerce stack ---
# seed | shopify. Shopify loads merchants/SKUs from the Storefront API on reset.
CATALOG_SOURCE=seed
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_TOKEN=
# Optional Admin API token (scope write_draft_orders): mirrors fills as draft orders.
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2025-07
SHOPIFY_DEFAULT_FLOOR_RATIO=0.9

# PostHog project API key (phc_...). Use https://eu.i.posthog.com for EU projects.
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
